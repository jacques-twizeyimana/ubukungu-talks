# MongoDB (docker compose up -d starts one on localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ubukungu

# Public site URL, used for canonical links, sitemap, RSS and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the newsroom session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Editor account created by `pnpm seed` (local testing only)
SEED_EDITOR_EMAIL=editor@ubukungu.test
SEED_EDITOR_PASSWORD=change-me

# Buy Me a Coffee page
NEXT_PUBLIC_COFFEE_URL=https://www.buymeacoffee.com/ubukungutalks
